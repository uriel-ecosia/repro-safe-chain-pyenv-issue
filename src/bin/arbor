#!/usr/bin/env bash

# This is the executable entrypoint for the arbor CLI.
# It should be added to the user's path so that they can run arbor from anywhere in core.
#
# It checks that uv is installed and uses uv's automatic Python- and dependency-management.
# uv run handles all dependency synchronization automatically.

# This pattern is taken from Stack Overflow.
# https://stackoverflow.com/a/246128

resolve_filename() {
  cd -- "$1" &> /dev/null && pwd
}

SCRIPT_DIR="$(resolve_filename "$(dirname -- "${BASH_SOURCE[0]}")")"
ARBOR_PROJECT_ROOT="$(resolve_filename "$SCRIPT_DIR/..")"

echo $SCRIPT_DIR
echo $ARBOR_PROJECT_ROOT

# Store arguments in array to preserve quotes
ARGV=("$@")

# ---------------------------------------------

print_error() {
  echo "$1" >&2
}

if  ! command -v uv &> /dev/null; then
  print_error "\`arbor\` requires \`uv\` to be installed. Please see the README for more details"
  exit 1
fi

if [[ -n "$_ARBOR_COMPLETE" ]]; then
  uv run --project "$ARBOR_PROJECT_ROOT" arbor
  exit
fi

# ---------------------------------------------

print_error "🌲 arbor ${ARGV[*]}"

# Run arbor - uv automatically handles both Python version and dependency synchronization

exec uv --verbose run --project "$ARBOR_PROJECT_ROOT" arbor "${ARGV[@]}"
